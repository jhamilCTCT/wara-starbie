	(text "Power stage wiring:" (at 133.35 44.45 0)
		(effects
			(font (size 1.4 1.4))
		)
	)
	(text "J1.VBUS -> USB_5V" (at 139.7 50.8 0)
		(effects (font (size 1.27 1.27)))
	)
	(text "J1.CC1 -> R1 5.1k -> GND" (at 139.7 55.88 0)
		(effects (font (size 1.27 1.27)))
	)
	(text "J1.CC2 -> R2 5.1k -> GND" (at 139.7 60.96 0)
		(effects (font (size 1.27 1.27)))
	)
	(text "U3 MCP73831: VDD=USB_5V, VBAT=BAT+, VSS=GND" (at 139.7 66.04 0)
		(effects (font (size 1.27 1.27)))
	)
	(text "U3.PROG -> R8 -> GND, U3.STAT -> optional charge LED" (at 139.7 71.12 0)
		(effects (font (size 1.27 1.27)))
	)
	(text "J2.1=BAT+, J2.2=GND" (at 139.7 76.2 0)
		(effects (font (size 1.27 1.27)))
	)
	(text "BAT+ -> SW1 -> VBAT_SW -> U4.VIN" (at 139.7 81.28 0)
		(effects (font (size 1.27 1.27)))
	)
	(text "U4 AP2112K: VIN=VBAT_SW, VOUT=+3V3, GND=GND" (at 139.7 86.36 0)
		(effects (font (size 1.27 1.27)))
	)
	(text "C1 at VIN, C2 at VOUT, C3 near charger, 100nF decoupling per IC" (at 139.7 91.44 0)
		(effects (font (size 1.27 1.27)))
	)
	(text "MCU and I2C stage:" (at 133.35 104.14 0)
		(effects
			(font (size 1.4 1.4))
		)
	)
	(text "U1 power: +3V3 and GND" (at 139.7 109.22 0)
		(effects (font (size 1.27 1.27)))
	)
	(text "Suggested GPIO map: SDA=GPIO4, SCL=GPIO5, BTN1=GPIO6, BTN2=GPIO7" (at 139.7 114.3 0)
		(effects (font (size 1.27 1.27)))
	)
	(text "BTN3=GPIO8, BUZZER=GPIO9, LED_USER=GPIO10, UART_TX=GPIO0, UART_RX=GPIO1" (at 139.7 119.38 0)
		(effects (font (size 1.27 1.27)))
	)
	(text "I2C_SDA -> R3 4.7k -> +3V3" (at 139.7 124.46 0)
		(effects (font (size 1.27 1.27)))
	)
	(text "I2C_SCL -> R4 4.7k -> +3V3" (at 139.7 129.54 0)
		(effects (font (size 1.27 1.27)))
	)
	(text "U2 LIS3DH: VDD=+3V3, GND=GND, SDA=I2C_SDA, SCL=I2C_SCL" (at 139.7 134.62 0)
		(effects (font (size 1.27 1.27)))
	)
	(text "U2 INT1/INT2 optional to GPIO2/GPIO3, SA0 sets address, CS tied for I2C mode" (at 139.7 139.7 0)
		(effects (font (size 1.27 1.27)))
	)
	(text "J3 OLED: 1=GND 2=+3V3 3=SCL 4=SDA" (at 139.7 144.78 0)
		(effects (font (size 1.27 1.27)))
	)
